---
/* HomePage.astro — tout le contenu de l'accueil, dans UNE langue.
   Les deux pages (src/pages/index.astro et src/pages/en/index.astro)
   l'utilisent avec lang="fr" ou lang="en" : un seul code, deux langues. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import DelphiBand from './DelphiBand.astro';
import LangSuggest from './LangSuggest.astro';
import GemScene from './GemScene.astro';
import ProjectsSection from './ProjectsSection.astro';
import { useTranslations, type Lang, type UIKey } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

// Les sections à venir. data-gem indiquera plus tard à la scène 3D
// quelle ambiance de gemme afficher quand on arrive sur la section.
const sections: { id: string; title: UIKey; gem: string }[] = [
  { id: 'apropos', title: 'nav.about', gem: 'quartz-rose' },
  { id: 'experience', title: 'nav.experience', gem: 'emerald' },
  { id: 'competences', title: 'nav.skills', gem: 'amethyst' },
  { id: 'contact', title: 'nav.contact', gem: 'ruby' },
];
---

<BaseLayout lang={lang}>
  <GemScene lang={lang} />
  <Header lang={lang} />
  <main>
    <Hero lang={lang} />
    <DelphiBand lang={lang} />

    {sections.slice(0, 1).map((s) => (
      <section id={s.id} class="section" data-gem={s.gem}>
        <div class="container">
          <h2 class="section-title">{t(s.title)}</h2>
          <p class="placeholder">{t('section.wip')}</p>
        </div>
      </section>
    ))}

    <!-- Projets : une vraie section, avec ses cartes (voir ProjectsSection.astro) -->
    <ProjectsSection lang={lang} />

    {sections.slice(1).map((s) => (
      <section id={s.id} class="section" data-gem={s.gem}>
        <div class="container">
          <h2 class="section-title">{t(s.title)}</h2>
          <p class="placeholder">{t('section.wip')}</p>
        </div>
      </section>
    ))}
  </main>
  <LangSuggest lang={lang} />
</BaseLayout>

<style>
  /* main passe au-dessus du canvas 3D (z-index 0) */
  main { position: relative; z-index: 1; }
  .placeholder { color: var(--faint); }
</style>
