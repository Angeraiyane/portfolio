---
/* DelphiBand.astro — le bandeau vers le double IA sur Delphi.
   C'est un simple lien externe : on prévient clairement la personne
   qu'elle quitte le site (texte visible + icône ↗ + précision pour lecteurs d'écran). */
import { useTranslations, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const DELPHI_URL = 'https://new.delphi.ai/ange-raiyane-essoazina';   // discussion écrite
const DELPHI_CALL_URL = `${DELPHI_URL}/call`;                        // appel vocal
---

<section class="container" aria-labelledby="delphi-title">
  <div class="band">
    <div class="text">
      <div class="icon" aria-hidden="true">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="var(--pyrite-light)" stroke-width="1.6" stroke-linecap="round">
          <path d="M4 10v4M8 7v10M12 4v16M16 7v10M20 10v4" />
        </svg>
      </div>
      <div>
        <h2 id="delphi-title">{t('delphi.title')}</h2>
        <p>{t('delphi.text')}</p>
      </div>
    </div>

    <div class="side">
      <div class="actions">
        <!-- target="_blank" ouvre un nouvel onglet ; rel="noopener" est une protection de sécurité -->
        <a class="btn btn-gold" href={DELPHI_URL} target="_blank" rel="noopener">
          {t('delphi.chat')} <span class="ext" aria-hidden="true">↗</span>
          <span class="sr-only">{t('delphi.newtab')}</span>
        </a>
        <a class="btn btn-ghost" href={DELPHI_CALL_URL} target="_blank" rel="noopener">
          {t('delphi.call')} <span class="ext" aria-hidden="true">↗</span>
          <span class="sr-only">{t('delphi.newtab')}</span>
        </a>
      </div>
      <p class="leaving">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />
        </svg>
        {t('delphi.leaving')}
      </p>
    </div>
  </div>
</section>

<style>
  .band {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px;
    padding: 28px 32px; border: 1px solid #243564; border-radius: 18px; background: rgba(12, 22, 48, 0.6);
  }
  .text { display: flex; gap: 18px; align-items: center; flex: 1 1 460px; }
  .icon { flex: none; width: 56px; height: 56px; border-radius: 50%; border: 1px solid var(--pyrite); display: grid; place-items: center; }
  h2 { font-size: 30px; margin-bottom: 6px; }
  .text p { color: #b7bfd1; font-size: 15px; }
  .side { display: flex; flex-direction: column; gap: 10px; flex: 0 1 340px; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .ext { margin-left: 6px; font-size: 0.9em; }
  .leaving { display: flex; gap: 8px; align-items: flex-start; font-size: 13px; color: var(--muted); line-height: 1.45; }
  .leaving svg { flex: none; margin-top: 3px; }
</style>
