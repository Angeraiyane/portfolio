---
/* Hero.astro — le haut de la page d'accueil.
   Plus tard, la scène 3D des gemmes viendra se placer derrière ce texte. */
import { useTranslations, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
// Un CV par langue, à déposer dans le dossier public/
const cvFile = lang === 'fr' ? '/cv-ange-essoazina-fr.pdf' : '/cv-ange-essoazina-en.pdf';
---

<section id="accueil" class="hero">
  <div class="container hero-inner">
    <!-- data-decrypt : notre script repère cet attribut pour lancer l'effet -->
    <p class="mono kicker" data-decrypt={t('hero.kicker')}>{t('hero.kicker')}</p>

    <h1>Ange Raïyane<br />ESSOAZINA</h1>

    <p class="lead">{t('hero.lead')}</p>

    <div class="actions">
      <a class="btn btn-primary" href="#projets">{t('hero.cta.projects')}</a>
      <a class="btn btn-ghost" href={cvFile}>{t('hero.cta.cv')}</a>
    </div>

    <p class="availability">{t('hero.availability')}</p>
    <p class="hint mono">{t('hero.hint')}</p>
  </div>
</section>

<style>
  .hero { min-height: min(86vh, 760px); display: flex; align-items: center; }
  /* width: 100% : le texte reste calé à gauche, ce qui libère la droite de l'écran pour les pierres */
  .hero-inner { width: 100%; display: flex; flex-direction: column; gap: 24px; padding-block: 48px 96px; }
  .kicker { color: var(--accent); letter-spacing: 0.18em; min-height: 1.6em; }
  h1 { font-size: clamp(48px, 8vw, 92px); letter-spacing: 0.01em; }
  .lead { max-width: 46ch; font-size: clamp(17px, 1.6vw, 19px); color: #b7bfd1; }
  .actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 8px; }
  .availability { font-size: 14px; color: var(--faint); }
  /* L'astuce du jeu : seulement avec une souris (pas sur téléphone, où le jeu est désactivé) */
  .hint { display: none; font-size: 11px; color: var(--faint); max-width: 48ch; }
  @media (hover: hover) and (pointer: fine) and (min-width: 640px) { .hint { display: block; } }
</style>

<script>
  /* ------------------------------------------------------------------------
     L'EFFET "DÉCHIFFREMENT"
     Un <script> dans un composant Astro est envoyé au navigateur du visiteur.
     Astro le regroupe et l'optimise automatiquement.

     Principe : on affiche des caractères au hasard, puis on "verrouille"
     les vraies lettres une par une, de gauche à droite.
     ------------------------------------------------------------------------ */
  const GLYPHS = '#%&@$*+=<>/\\|01ΣΔλ';

  function decrypt(el: HTMLElement) {
    const target = el.dataset.decrypt ?? el.textContent ?? '';
    let frame = 0;
    const totalFrames = target.length * 3;     // ~3 images par lettre

    function tick() {
      // Combien de lettres sont déjà "verrouillées" à cette image
      const locked = Math.floor(frame / 3);
      let out = '';
      for (let i = 0; i < target.length; i++) {
        if (i < locked || target[i] === ' ') out += target[i];        // lettre définitive
        else out += GLYPHS[Math.floor(Math.random() * GLYPHS.length)]; // caractère au hasard
      }
      el.textContent = out;
      frame++;
      if (frame <= totalFrames) requestAnimationFrame(tick);          // image suivante (~60/s)
      else el.textContent = target;
    }
    tick();
  }

  // On respecte le réglage "réduire les animations" du système.
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduceMotion) {
    document.querySelectorAll<HTMLElement>('[data-decrypt]').forEach(decrypt);
  }
</script>
