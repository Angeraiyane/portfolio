---
/* ProjectPage.astro — la page détaillée d'un projet, dans une langue.
   Utilisée par src/pages/projets/[slug].astro (FR) et src/pages/en/projects/[slug].astro (EN). */
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import GemMark from './GemMark.astro';
import { useTranslations, localePath, projectPath, type Lang } from '../i18n/ui';

interface Props { entry: CollectionEntry<'projects'> }
const { entry } = Astro.props;
const { data } = entry;
const lang = data.lang as Lang;
const t = useTranslations(lang);

// render() transforme le Markdown du projet en HTML : <Content /> l'affiche
const { Content } = await render(entry);

const alternates = { fr: projectPath('fr', data.page), en: projectPath('en', data.page) };
---

<BaseLayout lang={lang} title={`${data.title} — Ange Raïyane ESSOAZINA`} description={data.summary} alternates={alternates}>
  <Header lang={lang} alternates={alternates} />
  <main class="container page">
    <a class="back" href={`${localePath(lang)}#projets`}>← {t('projects.back')}</a>

    <header class="intro" style={`--gem: var(--glow-${data.gem})`}>
      <span class="mono kicker"><GemMark gem={data.gem} size={18} /> {data.kicker}</span>
      <h1>{data.title}</h1>
      <p class="summary">{data.summary}</p>
      <div class="meta">
        <p class="metric">{data.badge}</p>
        <p class="mono tags">{data.tags.join('  /  ')}</p>
      </div>
    </header>

    <!-- "prose" : les styles du texte long (titres, listes, tableaux), définis dans global.css -->
    <article class="prose">
      <Content />
    </article>

    {data.github && (
      <a class="btn btn-primary github" href={data.github} target="_blank" rel="noopener">
        {t('projects.viewCode')} <span class="ext" aria-hidden="true">↗</span>
        <span class="sr-only">{t('projects.newtab')}</span>
      </a>
    )}
  </main>
</BaseLayout>

<style>
  .page { max-width: 820px; padding-block: 32px 120px; }
  .back { display: inline-block; margin-bottom: 40px; color: var(--muted); text-decoration: none; font-size: 15px; }
  .back:hover { color: var(--ink); }
  .intro { display: flex; flex-direction: column; gap: 16px; padding-bottom: 40px; margin-bottom: 40px; border-bottom: 1px solid var(--line); }
  .kicker { display: flex; align-items: center; gap: 10px; color: #7f8fb8; font-size: 12px; }
  h1 { font-size: clamp(44px, 7vw, 72px); }
  .summary { font-size: 19px; color: #b7bfd1; }
  .meta { display: flex; flex-direction: column; gap: 10px; }
  .metric { font-family: var(--font-display); font-size: 28px; color: var(--gem); }
  .tags { color: #7f8fb8; font-size: 12px; }
  .github { margin-top: 48px; }
</style>
