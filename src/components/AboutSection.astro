---
/* AboutSection.astro — À propos (salle quartz rose).
   Le texte vient de src/data/profile.ts : ce composant ne fait que la mise en page. */
import { about, education, distinctions, languages } from '../data/profile';
import { useTranslations, type Lang } from '../i18n/ui';
import GemMark from './GemMark.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="apropos" class="section room" style="--gem: #ffb3c6">
  <div class="container">
    <div class="room-head">
      <GemMark gem="quartz" size={26} />
      <h2 class="section-title">{t('nav.about')}</h2>
    </div>

    <div class="grid">
      <div class="story">
        <p class="intro">{about.intro[lang]}</p>
        {about.paragraphs.map((p) => <p>{p[lang]}</p>)}
      </div>

      <aside class="facts">
        <h3 class="label">{t('about.education')}</h3>
        <ul class="list">
          {education.map((e) => (
            <li>
              <span class="mono period">{e.period}</span>
              <span class="what">{e.title[lang]}</span>
              <span class="where">{e.place[lang]}{e.note && <> · {e.note[lang]}</>}</span>
            </li>
          ))}
        </ul>

        <h3 class="label">{t('about.distinctions')}</h3>
        <ul class="list simple">
          {distinctions.map((d) => <li>{d[lang]}</li>)}
        </ul>

        <h3 class="label">{t('about.languages')}</h3>
        <ul class="langs">
          {languages.map((l) => (
            <li><span>{l.name[lang]}</span><span class="mono">{l.level[lang]}</span></li>
          ))}
        </ul>
      </aside>
    </div>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: clamp(40px, 6vw, 96px); }
  .story { display: flex; flex-direction: column; gap: 20px; color: #b7bfd1; max-width: 62ch; }
  .intro { font-family: var(--font-display); font-size: clamp(26px, 3vw, 36px); line-height: 1.25; color: var(--ink); }
  .facts { display: flex; flex-direction: column; }
  .facts h3 { margin: 0 0 12px; }
  .facts h3:not(:first-child) { margin-top: 36px; }
  ul { list-style: none; margin: 0; padding: 0; }
  .list li { display: flex; flex-direction: column; gap: 2px; padding: 14px 0; border-top: 1px solid var(--line); }
  .period { font-size: 11px; color: var(--gem); }
  .what { font-weight: 600; }
  .where { color: var(--muted); font-size: 14px; }
  .simple li { color: #b7bfd1; font-size: 15px; }
  .langs li { display: flex; justify-content: space-between; padding: 10px 0; border-top: 1px solid var(--line); }
  .langs .mono { font-size: 12px; color: var(--muted); }
  @media (max-width: 860px) { .grid { grid-template-columns: minmax(0, 1fr); } }
</style>
