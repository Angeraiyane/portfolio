---
/* Header.astro — logo, navigation et bascule FR / EN.
   Les liens sont générés depuis un tableau : pour ajouter une section,
   on ajoute une ligne ici, pas du HTML. */
import { useTranslations, localePath, languages, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const links = [
  { href: '#apropos', label: t('nav.about') },
  { href: '#projets', label: t('nav.projects') },
  { href: '#experience', label: t('nav.experience') },
  { href: '#competences', label: t('nav.skills') },
  { href: '#contact', label: t('nav.contact') },
];

// Object.keys(languages) = ['fr', 'en'] : un bouton par langue
const langs = Object.keys(languages) as Lang[];
---

<header class="header container">
  <a href="#accueil" class="logo" aria-label={t('nav.home')}>
    <!-- Notre gemme emblème en SVG : un lapis avec deux paillettes de pyrite -->
    <svg width="30" height="30" viewBox="0 0 100 100" aria-hidden="true">
      <polygon points="50,4 92,30 80,86 20,86 8,30" fill="var(--lapis)" />
      <polygon points="50,22 72,34 66,64 34,64 28,34" fill="var(--lapis-light)" />
      <circle cx="40" cy="44" r="3" fill="var(--pyrite)" />
      <circle cx="60" cy="56" r="2" fill="var(--pyrite)" />
    </svg>
    <span>A·R·E</span>
  </a>

  <nav aria-label={t('nav.main')}>
    <ul>
      {links.map((link) => (
        <li><a href={link.href}>{link.label}</a></li>
      ))}
    </ul>
  </nav>

  <div class="lang" role="group" aria-label={t('lang.switch')}>
    {langs.map((code) => (
      <a
        href={localePath(code)}
        hreflang={code}
        lang={code}
        aria-label={languages[code]}
        aria-current={code === lang ? 'true' : undefined}
        data-lang-choice={code}
      >
        {code.toUpperCase()}
      </a>
    ))}
  </div>
</header>

<style>
  /* Dans un fichier .astro, ce <style> ne s'applique QU'À ce composant :
     on dit qu'il est "scopé". */
  .header {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
    gap: 16px 32px; padding-block: 24px;
    position: relative; z-index: 2;
  }
  .logo { display: flex; align-items: center; gap: 12px; color: var(--ink); text-decoration: none; }
  .logo span { font-family: var(--font-display); font-size: 20px; letter-spacing: 0.2em; }
  nav ul { display: flex; flex-wrap: wrap; gap: 8px 28px; list-style: none; margin: 0; padding: 0; }
  nav a { color: var(--muted); text-decoration: none; font-size: 15px; transition: color 0.2s; }
  nav a:hover { color: var(--ink); }
  .lang { display: flex; gap: 4px; font-family: var(--font-mono); font-size: 12px; }
  .lang a {
    display: grid; place-items: center; min-width: 44px; min-height: 36px;
    border: 1px solid var(--line); border-radius: 6px; color: var(--muted); text-decoration: none;
  }
  .lang a[aria-current='true'] { background: var(--lapis); border-color: var(--lapis); color: #fff; }
</style>

<script>
  // Quand la personne choisit une langue, on s'en souvient (dans son navigateur uniquement)
  // pour ne plus lui proposer l'autre langue.
  document.querySelectorAll<HTMLAnchorElement>('[data-lang-choice]').forEach((a) => {
    a.addEventListener('click', () => {
      try { localStorage.setItem('lang-choice', a.dataset.langChoice ?? ''); } catch {}
    });
  });
</script>
