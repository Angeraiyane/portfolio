---
/* ==========================================================================
   BaseLayout.astro — le "squelette" commun à toutes les pages
   --------------------------------------------------------------------------
   Ce bloc entre les "---" s'exécute au moment où Astro CONSTRUIT le site,
   jamais dans le navigateur du visiteur. On y prépare les données.
   ========================================================================== */
import '../styles/global.css';   // Astro inclut automatiquement ce CSS dans la page
import { useTranslations, localePath, type Lang } from '../i18n/ui';

// Les "props" : les paramètres qu'une page passe à ce layout.
interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  // Les adresses de CETTE page dans chaque langue (par défaut : l'accueil)
  alternates?: { fr: string; en: string };
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const title = Astro.props.title ?? t('meta.title');
const description = Astro.props.description ?? t('meta.description');
const alternates = Astro.props.alternates ?? { fr: localePath('fr'), en: localePath('en') };
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- SEO : ce que Google affiche dans ses résultats -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Ange Raïyane ESSOAZINA" />

    <!-- hreflang : on dit à Google "cette page existe en français ICI et en anglais LÀ".
         Il montre ainsi la bonne version à chaque personne qui cherche ton nom. -->
    <link rel="alternate" hreflang="fr" href={alternates.fr} />
    <link rel="alternate" hreflang="en" href={alternates.en} />
    <link rel="alternate" hreflang="x-default" href={alternates.fr} />

    <!-- Aperçu quand le lien est partagé (LinkedIn, WhatsApp...) -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_US'} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Polices Google : "preconnect" ouvre la connexion en avance pour gagner du temps -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:wght@400;500&family=Hanken+Grotesk:wght@400;500;600&family=Martian+Mono:wght@300;400&display=swap"
    />
  </head>
  <body>
    <!-- <slot /> = l'endroit où le contenu de chaque page vient s'insérer -->
    <slot />
  </body>
</html>
